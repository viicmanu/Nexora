{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nexora",
  "version": "0.1.0",
  "identifier": "com.nexora.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexora",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Organizador inteligente de archivos",
    "longDescription": "Nexora organiza archivos locales con IA, clasifica documentos automáticamente y permite revisar sugerencias, gestionar carpetas vigiladas y mejorar la precisión.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
