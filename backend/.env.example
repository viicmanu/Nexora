# Copia este archivo como .env y ajusta los valores.

# --- Proveedor de IA: anthropic | openai | gemini | ollama ---
NEXORA_LLM_PROVEEDOR=anthropic
# Con anthropic el modelo por defecto es claude-opus-5-5. Con los demás es obligatorio, p. ej.:
# NEXORA_LLM_MODELO=llama3.1          (ollama)
# NEXORA_OLLAMA_URL=http://localhost:11434

# Claves de cada proveedor (solo la del que uses).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Archivos ---
# Formato JSON. En Windows usa barras normales.
NEXORA_CARPETAS_VIGILADAS=["C:/Users/TU_USUARIO/Downloads"]
NEXORA_RAIZ_ORGANIZADA=C:/Users/TU_USUARIO/Nexora
NEXORA_UMBRAL_CONFIANZA=0.85

# --- Servidor ---
NEXORA_HOST=127.0.0.1
NEXORA_PORT=8765
